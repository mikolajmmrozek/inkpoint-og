{
  "name": "Auto-sync booking to Google Calendar",
  "description": "Automatyczna synchronizacja ka\u017cdej rezerwacji do dedykowanego kalendarza Google artysty \u2014 uruchamiana przy tworzeniu, edycji i usuwaniu rezerwacji.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"gcal_event_id\") == null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update",
        "delete"
      ],
      "entity_name": "Booking"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_sync_booking_to_google_calendar",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "manageGoogleCalendar",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "manageGoogleCalendar"
  }
}
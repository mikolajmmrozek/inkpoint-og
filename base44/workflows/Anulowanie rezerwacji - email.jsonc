{
  "name": "Anulowanie rezerwacji \u2014 email",
  "description": "Wysy\u0142a klientowi maila o anulowaniu rezerwacji, gdy status bookinga zmieni si\u0119 na 'cancelled'. Zawiera przycisk 'Um\u00f3w ponownie' oraz dane kontaktowe studia.",
  "trigger": {
    "condition": "${ (.trigger.event_type == \"update\") and (.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"cancelled\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Booking"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "booking_cancellation_email",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "send_cancellation": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendBookingCancellationEmail",
            "args": {
              "bookingId": "${ .trigger.data.id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Wy\u015blij anulowanie rezerwacji",
            "description": "Email o anulowaniu sesji \u2014 wysy\u0142any, gdy status bookinga zmieni si\u0119 na 'cancelled'."
          }
        }
      }
    ]
  }
}
{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "artist_id": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "session_date": {
      "type": "string"
    },
    "service_type": {
      "type": "string"
    },
    "rating_overall": {
      "type": "number",
      "description": "Overall rating 1-5"
    },
    "rating_artist": {
      "type": "number",
      "description": "Artist rating 1-5"
    },
    "short_review": {
      "type": "string",
      "description": "Short public review (max 200 chars)"
    },
    "extra_answers": {
      "type": "array",
      "description": "Answers to dynamic questions",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      }
    },
    "tattoo_photo_url": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "admin_note": {
      "type": "string"
    }
  },
  "required": [
    "client_name",
    "client_email",
    "rating_overall"
  ]
}
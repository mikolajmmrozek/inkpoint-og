{
  "name": "ShopPiercingOption",
  "type": "object",
  "properties": {
    "filter_group": {
      "type": "string",
      "enum": [
        "piercing",
        "clothing"
      ],
      "default": "piercing",
      "description": "Grupa filtr\u00f3w: piercing = przek\u0142ucia (miejsce i rodzaj), clothing = ubrania (rodzaj ubrania)"
    },
    "kind": {
      "type": "string",
      "enum": [
        "placement",
        "type",
        "category"
      ],
      "description": "placement = miejsce przek\u0142ucia (np. Ucho, Nos), type = rodzaj przek\u0142ucia (np. Lobe, Helix), category = rodzaj ubrania (np. Koszulki, Bluzy z kapturem)"
    },
    "name": {
      "type": "string",
      "description": "Nazwa opcji widoczna w filtrach i przy produkcie"
    },
    "order": {
      "type": "number",
      "default": 999,
      "description": "Kolejno\u015b\u0107 wy\u015bwietlania (mniejsza = wcze\u015bniej)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "kind",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
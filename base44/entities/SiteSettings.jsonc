{
  "name": "SiteSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique key"
    },
    "hero_video_url": {
      "type": "string"
    },
    "hero_tagline": {
      "type": "string"
    },
    "hero_subtext": {
      "type": "string"
    },
    "about_heading": {
      "type": "string"
    },
    "about_highlight_word": {
      "type": "string"
    },
    "about_paragraph_1": {
      "type": "string"
    },
    "about_paragraph_2": {
      "type": "string"
    },
    "about_image_url": {
      "type": "string"
    },
    "about_stats_number": {
      "type": "string"
    },
    "about_stats_text": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_address_street": {
      "type": "string"
    },
    "contact_address_city": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_hours": {
      "type": "string"
    },
    "contact_instagram": {
      "type": "string"
    },
    "contact_instagram_url": {
      "type": "string"
    },
    "contact_facebook": {
      "type": "string"
    },
    "contact_facebook_url": {
      "type": "string"
    },
    "contact_youtube": {
      "type": "string",
      "description": "YouTube channel name"
    },
    "contact_youtube_url": {
      "type": "string",
      "description": "YouTube channel URL"
    },
    "contact_tiktok": {
      "type": "string",
      "description": "TikTok profile name"
    },
    "contact_tiktok_url": {
      "type": "string",
      "description": "TikTok profile URL"
    },
    "contact_google_maps_url": {
      "type": "string"
    },
    "site_logo_url": {
      "type": "string"
    },
    "app_icon_url": {
      "type": "string"
    },
    "app_description": {
      "type": "string"
    },
    "theme_mode": {
      "type": "string",
      "enum": [
        "dark",
        "light"
      ],
      "default": "dark",
      "description": "Motyw strony publicznej: dark = ciemny, light = jasny"
    },
    "primary_color": {
      "type": "string",
      "default": "#FF007F",
      "description": "Kolor wiod\u0105cy (hex)"
    },
    "font_package": {
      "type": "string",
      "enum": [
        "original",
        "classic",
        "elegant",
        "modern",
        "fraunces"
      ],
      "default": "original",
      "description": "Pakiet czcionek: original, classic, elegant, modern, fraunces"
    }
  },
  "required": [
    "key"
  ]
}
{
  "name": "SiteSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique key, e.g. 'hero', 'about', 'contact', 'branding'"
    },
    "hero_video_url": {
      "type": "string",
      "description": "Looping background video URL"
    },
    "hero_tagline": {
      "type": "string",
      "description": "Main headline over the video"
    },
    "hero_subtext": {
      "type": "string",
      "description": "Subheadline / description"
    },
    "about_heading": {
      "type": "string",
      "description": "About section main heading"
    },
    "about_highlight_word": {
      "type": "string",
      "description": "Word to highlight in heading (e.g. POZOSTAJE)"
    },
    "about_paragraph_1": {
      "type": "string",
      "description": "First paragraph about studio"
    },
    "about_paragraph_2": {
      "type": "string",
      "description": "Second paragraph about studio"
    },
    "about_image_url": {
      "type": "string",
      "description": "About section image URL"
    },
    "about_stats_number": {
      "type": "string",
      "description": "Stats badge number (e.g. 4+)"
    },
    "about_stats_text": {
      "type": "string",
      "description": "Stats badge label (e.g. W WOLSZTYNIE)"
    },
    "contact_email": {
      "type": "string",
      "description": "Main contact email address"
    },
    "contact_address_street": {
      "type": "string",
      "description": "Street address"
    },
    "contact_address_city": {
      "type": "string",
      "description": "City and postal code"
    },
    "contact_phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "contact_hours": {
      "type": "string",
      "description": "Business hours"
    },
    "contact_instagram": {
      "type": "string",
      "description": "Instagram handle"
    },
    "contact_instagram_url": {
      "type": "string",
      "description": "Instagram profile URL"
    },
    "contact_facebook": {
      "type": "string",
      "description": "Facebook page name"
    },
    "contact_facebook_url": {
      "type": "string",
      "description": "Facebook page URL"
    },
    "contact_google_maps_url": {
      "type": "string",
      "description": "Google Maps link"
    },
    "site_logo_url": {
      "type": "string",
      "description": "Site logo image URL"
    },
    "app_icon_url": {
      "type": "string",
      "description": "Application icon URL"
    },
    "app_description": {
      "type": "string",
      "description": "Short application description for meta tags"
    }
  },
  "required": [
    "key"
  ]
}
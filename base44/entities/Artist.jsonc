{
  "name": "Artist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Full name of the artist"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier"
    },
    "bio": {
      "type": "string",
      "description": "Artist biography"
    },
    "specialty": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specialization tags"
    },
    "photo_url": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "instagram": {
      "type": "string"
    },
    "years_experience": {
      "type": "number"
    },
    "portfolio_images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "style": {
            "type": "string"
          }
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Czy artysta jest widoczny na publicznej stronie artyst\u00f3w"
    },
    "bookable_online": {
      "type": "boolean",
      "default": true,
      "description": "Czy klient mo\u017ce wybra\u0107 tego artyst\u0119 w rezerwacji online. false = ca\u0142kowicie ukryty w formularzu rezerwacji (nawet kafel), ale admin i sam artysta nadal mog\u0105 go zapisywa\u0107 w panelu."
    },
    "artist_cut_percent": {
      "type": "number",
      "default": 60,
      "description": "Procentowy udzia\u0142 artysty w przychodzie z sesji (np. 60 = 60%)"
    },
    "order": {
      "type": "number",
      "default": 999,
      "description": "Display order (lower = first)"
    },
    "gcal_calendar_id": {
      "type": "string",
      "description": "ID dedykowanego kalendarza Google Calendar dla tego artysty (auto-utoworzone)"
    }
  },
  "required": [
    "name"
  ]
}
{
  "name": "Client",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Imi\u0119 klienta"
    },
    "last_name": {
      "type": "string",
      "description": "Nazwisko klienta"
    },
    "name": {
      "type": "string",
      "description": "Pe\u0142ne imi\u0119 i nazwisko"
    },
    "email": {
      "type": "string",
      "description": "Adres e-mail klienta"
    },
    "phone": {
      "type": "string",
      "description": "Numer telefonu"
    },
    "avatar_url": {
      "type": "string",
      "description": "URL zdj\u0119cia profilowego klienta (uploadowane przez klienta w panelu lub pobrane od dostawcy logowania, np. Google)"
    },
    "notes": {
      "type": "string",
      "description": "Notatki o kliencie (alergie, preferencje itp.)"
    },
    "total_sessions": {
      "type": "number",
      "default": 0,
      "description": "Liczba sesji"
    },
    "user_id": {
      "type": "string",
      "description": "ID powi\u0105zanego konta u\u017cytkownika (Base44 User)"
    },
    "invite_sent": {
      "type": "boolean",
      "default": false,
      "description": "Czy wys\u0142ano zaproszenie do aplikacji"
    },
    "invite_sent_date": {
      "type": "string",
      "format": "date",
      "description": "Data wys\u0142ania zaproszenia"
    },
    "last_login": {
      "type": "string",
      "description": "Data ostatniego logowania klienta (ISO)"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Czy profil klienta zosta\u0142 ju\u017c przejrzany przez admina (do wska\u017anika \"nowi klienci\")"
    },
    "is_blocked": {
      "type": "boolean",
      "default": false,
      "description": "Czy klient jest zablokowany \u2014 traci mo\u017cliwo\u015b\u0107 rezerwacji sesji i wysy\u0142ania wiadomo\u015bci, bez informowania o blokadzie"
    },
    "auth_provider": {
      "type": "string",
      "enum": [
        "google",
        "email"
      ],
      "description": "Dostawca logowania: google = logowanie przez Google OAuth, email = e-mail/has\u0142o"
    },
    "source": {
      "type": "string",
      "enum": [
        "qr_form",
        "dashboard",
        "booking",
        "panel"
      ],
      "description": "Sk\u0105d powsta\u0142 profil klienta: qr_form = formularz QR, dashboard = r\u0119cznie z panelu, booking = rezerwacja online, panel = konto klienta"
    },
    "no_show_count": {
      "type": "number",
      "default": 0,
      "description": "Liczba aktywnych (niecofni\u0119tych) nieobecno\u015bci klienta \u2014 licznik historyczny"
    },
    "no_show_events": {
      "type": "array",
      "description": "Historia nieobecno\u015bci: kto i kiedy oznaczy\u0142, powi\u0105zana sesja oraz informacja o cofni\u0119ciu",
      "items": {
        "type": "object",
        "properties": {
          "booking_id": {
            "type": "string",
            "description": "ID sesji, kt\u00f3rej dotyczy nieobecno\u015b\u0107"
          },
          "session_id": {
            "type": "string",
            "description": "Numer sesji (cache)"
          },
          "date": {
            "type": "string",
            "description": "Data sesji, na kt\u00f3r\u0105 klient nie przyszed\u0142"
          },
          "marked_at": {
            "type": "string",
            "description": "Data i godzina oznaczenia (ISO)"
          },
          "marked_by_id": {
            "type": "string",
            "description": "ID osoby oznaczaj\u0105cej"
          },
          "marked_by_name": {
            "type": "string",
            "description": "Imi\u0119/nazwa osoby oznaczaj\u0105cej"
          },
          "reverted": {
            "type": "boolean",
            "default": false,
            "description": "True = oznaczenie cofni\u0119te (nie liczy si\u0119 do licznika)"
          },
          "reverted_at": {
            "type": "string",
            "description": "Data cofni\u0119cia (ISO)"
          },
          "reverted_by_name": {
            "type": "string",
            "description": "Kto cofn\u0105\u0142 oznaczenie"
          }
        }
      }
    }
  },
  "required": [
    "first_name"
  ]
}
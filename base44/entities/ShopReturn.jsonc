{
  "name": "ShopReturn",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "return",
        "complaint"
      ],
      "default": "return"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "variant_label": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "approved",
        "rejected",
        "received",
        "refunded"
      ],
      "default": "requested"
    },
    "admin_note": {
      "type": "string"
    },
    "resolution": {
      "type": "string"
    }
  },
  "required": [
    "order_id",
    "user_email",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "ShopCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nazwa kategorii"
    },
    "slug": {
      "type": "string",
      "description": "Identyfikator w adresie URL"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 999,
      "description": "Kolejno\u015b\u0107 wy\u015bwietlania (mniejsza = wcze\u015bniej)"
    },
    "filter_group": {
      "type": "string",
      "enum": [
        "none",
        "piercing",
        "clothing"
      ],
      "default": "none",
      "description": "Zestaw filtr\u00f3w dla kategorii: none = brak dodatkowych filtr\u00f3w, piercing = filtry miejsca i rodzaju przek\u0142ucia, clothing = filtry rodzaju ubrania"
    },
    "commission_type": {
      "type": "string",
      "enum": [
        "inherit",
        "none",
        "percent",
        "amount"
      ],
      "default": "inherit",
      "description": "Prowizja pracownika dla produkt\u00f3w tej kategorii: inherit = wsp\u00f3lna stawka ze sklepu, none = brak prowizji, percent = procent od sprzeda\u017cy, amount = sta\u0142a kwota od sztuki"
    },
    "commission_value": {
      "type": "number",
      "default": 0,
      "description": "Warto\u015b\u0107 prowizji dla tej kategorii: procent (commission_type = percent) albo kwota PLN od sztuki (amount)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
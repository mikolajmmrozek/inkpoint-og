{
  "name": "FeedbackSurveyConfig",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "default": "default"
    },
    "intro_text": {
      "type": "string",
      "description": "Intro text shown on survey page"
    },
    "thank_you_text": {
      "type": "string",
      "description": "Thank you message after submission"
    },
    "email_subject": {
      "type": "string",
      "description": "Email subject for survey invitation"
    },
    "email_body": {
      "type": "string",
      "description": "Email body template (use {client_name}, {link})"
    },
    "questions": {
      "type": "array",
      "description": "Dynamic list of survey questions",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "stars",
              "text",
              "textarea"
            ]
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  },
  "required": [
    "key"
  ]
}
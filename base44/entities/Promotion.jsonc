{
  "name": "Promotion",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "voucher",
        "discount"
      ],
      "description": "voucher = voucher na okaziciela z saldem, discount = kod zni\u017ckowy"
    },
    "code": {
      "type": "string",
      "description": "Unikalny kod (kr\u00f3tki ci\u0105g alfanumeryczny)"
    },
    "value_type": {
      "type": "string",
      "enum": [
        "amount",
        "percent"
      ],
      "default": "amount",
      "description": "amount = kwota PLN, percent = procent zni\u017cki"
    },
    "value": {
      "type": "number",
      "description": "Warto\u015b\u0107: kwota PLN (voucher / discount amount) lub procent (discount percent)"
    },
    "original_value": {
      "type": "number",
      "description": "Oryginalna warto\u015b\u0107 vouchera (przed ewentualnym przed\u0142u\u017ceniem grace)"
    },
    "balance": {
      "type": "number",
      "description": "Aktualne saldo vouchera (zmniejszane przy cz\u0119\u015bciowym u\u017cyciu)"
    },
    "usage_mode": {
      "type": "string",
      "enum": [
        "single",
        "multi"
      ],
      "default": "single",
      "description": "single = jednorazowy, multi = wielorazowy"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "True = aktywna (w\u0142\u0105czona), False = wy\u0142\u0105czona (tylko kody zni\u017ckowe)"
    },
    "assigned_client_email": {
      "type": "string",
      "description": "E-mail klienta, do kt\u00f3rego przypisana jest zni\u017cka (opcjonalne)"
    },
    "assigned_until": {
      "type": "string",
      "description": "Data do kt\u00f3rej przypisanie zni\u017cki jest aktywne (ISO datetime)"
    },
    "assignment_permanent": {
      "type": "boolean",
      "default": false,
      "description": "True = przypisanie na sta\u0142e"
    },
    "revoked": {
      "type": "boolean",
      "default": false,
      "description": "True = zni\u017cka/voucher odwo\u0142any r\u0119cznie"
    },
    "expires_at": {
      "type": "string",
      "description": "Data wa\u017cno\u015bci (ISO datetime)"
    },
    "grace_value": {
      "type": "number",
      "description": "Warto\u015b\u0107 'ostatniej szansy' po wyga\u015bni\u0119ciu vouchera"
    },
    "grace_expires_at": {
      "type": "string",
      "description": "Data wa\u017cno\u015bci 'ostatniej szansy' (ISO datetime)"
    },
    "is_grace": {
      "type": "boolean",
      "default": false,
      "description": "True = voucher w trybie 'ostatniej szansy'"
    },
    "used_at": {
      "type": "string",
      "description": "Data u\u017cycia (ISO datetime)"
    },
    "used_booking_id": {
      "type": "string",
      "description": "ID rezerwacji powi\u0105zanej z u\u017cyciem"
    },
    "qr_code_url": {
      "type": "string",
      "description": "URL obrazu kodu QR wygenerowanego przy tworzeniu"
    },
    "purchase_id": {
      "type": "string",
      "description": "ID zakupu (na przysz\u0142o\u015b\u0107, gdy vouchery kupowane online)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "used",
        "expired",
        "grace",
        "revoked"
      ],
      "default": "active",
      "description": "Status: active/used/expired/grace/revoked"
    }
  },
  "required": [
    "type",
    "code",
    "value",
    "expires_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.assigned_client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
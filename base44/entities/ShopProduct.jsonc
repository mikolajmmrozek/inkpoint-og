{
  "name": "ShopProduct",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "Identyfikator w adresie URL (np. t-shirt-romans)"
    },
    "short_description": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "category_name": {
      "type": "string",
      "description": "Nazwa kategorii (cache dla list)"
    },
    "collection_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "price": {
      "type": "number",
      "description": "Cena bazowa w PLN"
    },
    "compare_at_price": {
      "type": "number",
      "description": "Cena przekre\u015blona (opcjonalnie)"
    },
    "stock": {
      "type": "number",
      "default": 0,
      "description": "Stan magazynowy produktu bez wariant\u00f3w (liczba dost\u0119pnych sztuk)"
    },
    "restock": {
      "type": "boolean",
      "default": false,
      "description": "True = przy braku towaru pokazujemy 'Wkr\u00f3tce dost\u0119pne' (\u017c\u00f3\u0142ty), False = 'Wyprzedane' (szary)"
    },
    "shipping_cost": {
      "type": "number",
      "default": 0,
      "description": "Koszt dostawy tego produktu w PLN (0 = darmowa dostawa) \u2014 u\u017cywany, gdy produkt nie ma opcji dostawy"
    },
    "shipping_info": {
      "type": "string",
      "description": "Kr\u00f3tka informacja o wysy\u0142ce i pakowaniu tego produktu, np. 'Wysy\u0142ka 24\u201348 h' lub 'Wysy\u0142ka e-mail \u2014 natychmiast'"
    },
    "shipping_options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nazwa opcji dostawy, np. Paczkomat InPost"
          },
          "cost": {
            "type": "number",
            "default": 0,
            "description": "Koszt tej opcji w PLN (0 = darmowa)"
          }
        }
      },
      "description": "Opcje dostawy wybierane jako przyciski na stronie produktu"
    },
    "image_url": {
      "type": "string",
      "description": "Zdj\u0119cie g\u0142\u00f3wne"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variant_axes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nazwa osi wariantu, np. Rozmiar, Kolor"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Osie wariant\u00f3w \u2014 mo\u017ce ich by\u0107 dowolnie wiele"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Unikalny klucz kombinacji (np. Rozmiar:M|Kolor:Czarne)"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "price": {
            "type": "number"
          },
          "stock": {
            "type": "number",
            "default": 0
          },
          "sku": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "number",
      "default": 999
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
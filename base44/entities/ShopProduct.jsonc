{
  "name": "ShopProduct",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "Identyfikator w adresie URL (np. t-shirt-romans)"
    },
    "short_description": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "category_name": {
      "type": "string",
      "description": "Nazwa kategorii (cache dla list)"
    },
    "collection_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "price": {
      "type": "number",
      "description": "Cena bazowa w PLN"
    },
    "compare_at_price": {
      "type": "number",
      "description": "Cena przekre\u015blona (opcjonalnie)"
    },
    "pricing_mode": {
      "type": "string",
      "enum": [
        "fixed",
        "slider"
      ],
      "default": "fixed",
      "description": "fixed = sta\u0142a cena i warianty; slider = klient wybiera kwot\u0119 suwakiem (zakres i skok poni\u017cej)"
    },
    "slider_min": {
      "type": "number",
      "default": 100,
      "description": "Najni\u017csza kwota suwaka w PLN (tylko dla pricing_mode = slider)"
    },
    "slider_max": {
      "type": "number",
      "default": 2000,
      "description": "Najwy\u017csza kwota suwaka w PLN (tylko dla pricing_mode = slider)"
    },
    "slider_step": {
      "type": "number",
      "default": 10,
      "description": "Skok suwaka w PLN (tylko dla pricing_mode = slider)"
    },
    "is_voucher": {
      "type": "boolean",
      "default": false,
      "description": "Znacznik starszych produkt\u00f3w voucher \u2014 r\u00f3wnowa\u017cny pricing_mode = slider"
    },
    "unlimited_stock": {
      "type": "boolean",
      "default": false,
      "description": "True = produkt bez stanu magazynowego (nielimitowany) \u2014 nie pilnuje sztuk, sprzeda\u017c nadal liczy si\u0119 w statystykach"
    },
    "stock": {
      "type": "number",
      "default": 0,
      "description": "Stan magazynowy produktu bez wariant\u00f3w (liczba dost\u0119pnych sztuk)"
    },
    "restock": {
      "type": "boolean",
      "default": false,
      "description": "True = przy braku towaru pokazujemy 'Wkr\u00f3tce dost\u0119pne' (\u017c\u00f3\u0142ty), False = 'Wyprzedane' (szary)"
    },
    "shipping_form_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Formy wysy\u0142ki przypisane do produktu (ID z listy ShippingForm)"
    },
    "shipping_cost": {
      "type": "number",
      "default": 0,
      "description": "Koszt dostawy tego produktu w PLN (0 = darmowa) \u2014 u\u017cywany, gdy produkt nie ma przypisanych form wysy\u0142ki"
    },
    "shipping_info": {
      "type": "string",
      "description": "Kr\u00f3tka informacja o wysy\u0142ce i pakowaniu tego produktu, np. 'Wysy\u0142ka 24\u201348 h' lub 'Pakowanie 50 z\u0142 \u00b7 odbi\u00f3r w studio'"
    },
    "shipping_options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nazwa opcji dostawy, np. Paczkomat InPost"
          },
          "cost": {
            "type": "number",
            "default": 0,
            "description": "Koszt tej opcji w PLN (0 = darmowa)"
          }
        }
      },
      "description": "Starsze opcje dostawy wpisywane w produkcie \u2014 u\u017cywane tylko, gdy produkt nie ma przypisanych form wysy\u0142ki"
    },
    "image_url": {
      "type": "string",
      "description": "Zdj\u0119cie g\u0142\u00f3wne"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variant_axes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nazwa osi wariantu, np. Rozmiar, Kolor"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Osie wariant\u00f3w \u2014 mo\u017ce ich by\u0107 dowolnie wiele"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Unikalny klucz kombinacji (np. Rozmiar:M|Kolor:Czarne)"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "price": {
            "type": "number"
          },
          "stock": {
            "type": "number",
            "default": 0
          },
          "sku": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "number",
      "default": 999
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "ShopProduct",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "Identyfikator w adresie URL (np. t-shirt-romans)"
    },
    "short_description": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "category_name": {
      "type": "string",
      "description": "Nazwa kategorii (cache dla list)"
    },
    "piercing_placements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Miejsca przek\u0142ucia przypisane do produktu (np. Ucho, Nos) \u2014 u\u017cywane w filtrach kategorii z grup\u0105 'piercing'"
    },
    "piercing_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Rodzaje przek\u0142ucia przypisane do produktu (np. Lobe, Helix) \u2014 u\u017cywane w filtrach kategorii z grup\u0105 'piercing'"
    },
    "clothing_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Rodzaje ubrania przypisane do produktu (np. Spodnie, Koszulki, Bluzy z kapturem) \u2014 u\u017cywane w filtrach kategorii z grup\u0105 'clothing'"
    },
    "collection_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "price": {
      "type": "number",
      "description": "Cena bazowa w PLN \u2014 u\u017cywana tylko dla produkt\u00f3w bez wariant\u00f3w"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "none",
        "amount",
        "percent"
      ],
      "default": "none",
      "description": "Zni\u017cka sklepowa ustawiana w panelu: none = brak, amount = kwota w PLN, percent = procent od ceny"
    },
    "discount_value": {
      "type": "number",
      "default": 0,
      "description": "Warto\u015b\u0107 zni\u017cki: kwota w PLN (discount_type = amount) albo procent (discount_type = percent). Obni\u017ca cen\u0119 produktu, wariant\u00f3w i wielosztuk oraz cen\u0119 w koszyku."
    },
    "pricing_mode": {
      "type": "string",
      "enum": [
        "fixed",
        "slider"
      ],
      "default": "fixed",
      "description": "fixed = sta\u0142a cena i warianty; slider = klient wybiera kwot\u0119 suwakiem (zakres i skok poni\u017cej)"
    },
    "slider_min": {
      "type": "number",
      "default": 100,
      "description": "Najni\u017csza kwota suwaka w PLN (tylko dla pricing_mode = slider)"
    },
    "slider_max": {
      "type": "number",
      "default": 2000,
      "description": "Najwy\u017csza kwota suwaka w PLN (tylko dla pricing_mode = slider)"
    },
    "slider_step": {
      "type": "number",
      "default": 10,
      "description": "Skok suwaka w PLN (tylko dla pricing_mode = slider)"
    },
    "is_voucher": {
      "type": "boolean",
      "default": false,
      "description": "Znacznik starszych produkt\u00f3w voucher \u2014 r\u00f3wnowa\u017cny pricing_mode = slider"
    },
    "unlimited_stock": {
      "type": "boolean",
      "default": false,
      "description": "True = produkt bez stanu magazynowego (nielimitowany) \u2014 dotyczy produkt\u00f3w bez wariant\u00f3w"
    },
    "stock": {
      "type": "number",
      "default": 0,
      "description": "Stan magazynowy produktu bez wariant\u00f3w (liczba dost\u0119pnych sztuk)"
    },
    "restock": {
      "type": "boolean",
      "default": false,
      "description": "True = przy braku towaru pokazujemy 'Wkr\u00f3tce dost\u0119pne' (\u017c\u00f3\u0142ty), False = 'Wyprzedane' (szary)"
    },
    "shipping_form_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Formy wysy\u0142ki przypisane do produktu (ID z listy ShippingForm) \u2014 koszt i czas dostawy pochodz\u0105 z formy"
    },
    "pickup_in_studio": {
      "type": "boolean",
      "default": false,
      "description": "True = bezp\u0142atny odbi\u00f3r w studio dost\u0119pny dla tego produktu (dodatkowa opcja dostawy, koszt 0)"
    },
    "shipping_cost": {
      "type": "number",
      "default": 0,
      "description": "Historyczny koszt dostawy produktu \u2014 u\u017cywany tylko, gdy produkt nie ma przypisanych form wysy\u0142ki"
    },
    "shipping_info": {
      "type": "string",
      "description": "Historyczna informacja o wysy\u0142ce \u2014 czas dostawy jest teraz przypisany do formy wysy\u0142ki"
    },
    "shipping_options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nazwa opcji dostawy, np. Paczkomat InPost"
          },
          "cost": {
            "type": "number",
            "default": 0,
            "description": "Koszt tej opcji w PLN (0 = darmowa)"
          }
        }
      },
      "description": "Starsze opcje dostawy wpisywane w produkcie \u2014 u\u017cywane tylko, gdy produkt nie ma przypisanych form wysy\u0142ki"
    },
    "image_url": {
      "type": "string",
      "description": "Zdj\u0119cie g\u0142\u00f3wne"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variant_axes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nazwa osi wariantu, np. Rozmiar, Kolor"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Osie wariant\u00f3w \u2014 mo\u017ce ich by\u0107 dowolnie wiele"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Unikalny klucz kombinacji (np. Rozmiar:M|Kolor:Czarne)"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "price": {
            "type": "number"
          },
          "stock": {
            "type": "number",
            "default": 0
          },
          "sku": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean",
            "default": true
          },
          "multipacks": {
            "type": "array",
            "description": "Wielosztuki tego wariantu \u2014 ka\u017cdy wariant ma w\u0142asne pakiety i w\u0142asn\u0105 cen\u0119 pakietu liczon\u0105 od ceny tego wariantu. Korzystaj\u0105 ze wsp\u00f3lnego stanu magazynowego wariantu: pakiet zjada tyle sztuk, ile ma w \u015brodku.",
            "items": {
              "type": "object",
              "properties": {
                "units": {
                  "type": "number",
                  "default": 2,
                  "description": "Liczba sztuk w pakiecie (np. 2 = dwa kolczyki w komplecie)"
                },
                "label": {
                  "type": "string",
                  "description": "Nazwa pakietu widoczna dla klienta, np. '2 szt. w komplecie'. Puste = '<liczba> szt. w komplecie'"
                },
                "pricing": {
                  "type": "string",
                  "enum": [
                    "percent",
                    "manual"
                  ],
                  "default": "percent",
                  "description": "percent = cena wariantu \u00d7 liczba sztuk minus zni\u017cka procentowa, manual = kwota wpisana r\u0119cznie"
                },
                "price": {
                  "type": "number",
                  "default": 0,
                  "description": "Cena pakietu w PLN (tylko dla pricing = manual)"
                },
                "discount_percent": {
                  "type": "number",
                  "default": 0,
                  "description": "Zni\u017cka procentowa na pakiet (tylko dla pricing = percent)"
                }
              }
            }
          }
        }
      }
    },
    "multipacks": {
      "type": "array",
      "description": "Wielosztuki produktu \u2014 u\u017cywane tylko dla produkt\u00f3w bez wariant\u00f3w. Produkty z wariantami trzymaj\u0105 pakiety w ka\u017cdym wariancie.",
      "items": {
        "type": "object",
        "properties": {
          "units": {
            "type": "number",
            "default": 2,
            "description": "Liczba sztuk w pakiecie (np. 2 = dwie sztuki w komplecie)"
          },
          "label": {
            "type": "string",
            "description": "Nazwa pakietu widoczna dla klienta, np. '2 szt. w komplecie'. Puste = '<liczba> szt. w komplecie'"
          },
          "pricing": {
            "type": "string",
            "enum": [
              "percent",
              "manual"
            ],
            "default": "percent",
            "description": "percent = cena produktu \u00d7 liczba sztuk minus zni\u017cka procentowa, manual = kwota wpisana r\u0119cznie"
          },
          "price": {
            "type": "number",
            "default": 0,
            "description": "Cena pakietu w PLN (tylko dla pricing = manual)"
          },
          "discount_percent": {
            "type": "number",
            "default": 0,
            "description": "Zni\u017cka procentowa na pakiet (tylko dla pricing = percent)"
          }
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "number",
      "default": 999
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
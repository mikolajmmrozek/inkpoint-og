{
  "name": "Booking",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Unikalny ID sesji (np. SES-20260601-001)"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "artist_id": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "session_date": {
      "type": "string",
      "format": "date"
    },
    "session_time": {
      "type": "string"
    },
    "session_end_time": {
      "type": "string",
      "description": "End time of the session (HH:MM)"
    },
    "session_duration": {
      "type": "number",
      "description": "Duration in minutes"
    },
    "tattoo_description": {
      "type": "string"
    },
    "tattoo_placement": {
      "type": "string"
    },
    "reference_images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_price": {
      "type": "number"
    },
    "deposit_paid": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "health_form_completed": {
      "type": "boolean",
      "default": false
    },
    "health_form_token": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_name",
    "client_email",
    "session_date"
  ]
}
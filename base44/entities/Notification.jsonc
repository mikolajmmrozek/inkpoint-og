{
  "name": "Notification",
  "type": "object",
  "properties": {
    "target_email": {
      "type": "string",
      "description": "E-mail odbiorcy powiadomienia"
    },
    "title": {
      "type": "string",
      "description": "Kr\u00f3tki tytu\u0142 powiadomienia"
    },
    "message": {
      "type": "string",
      "description": "Tre\u015b\u0107 powiadomienia"
    },
    "category": {
      "type": "string",
      "enum": [
        "booking",
        "message",
        "system",
        "health_form"
      ],
      "default": "system",
      "description": "Kategoria powiadomienia"
    },
    "link_path": {
      "type": "string",
      "description": "\u015acie\u017cka do przekierowania po klikni\u0119ciu (np. /panel/sessions)"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "booking_id": {
      "type": "string",
      "description": "ID powi\u0105zanej rezerwacji (do automatycznego odznaczania)"
    }
  },
  "required": [
    "target_email",
    "title",
    "message"
  ]
}
{
  "name": "ShopCart",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "variant_key": {
            "type": "string"
          },
          "variant_label": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "units": {
            "type": "number",
            "default": 1,
            "description": "Liczba sztuk w jednym pakiecie (wielosztuka) \u2014 1 = pojedyncza sztuka. Quantity = liczba pakiet\u00f3w."
          }
        }
      }
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}
{
  "name": "ShopSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "default": "default"
    },
    "currency": {
      "type": "string",
      "default": "PLN",
      "description": "Waluta sklepu (np. PLN, EUR) \u2014 dotyczy wszystkich cen wpisanych r\u0119cznie w sklepie: produkt\u00f3w, wariant\u00f3w, wielosztuk i form wysy\u0142ki."
    },
    "new_badge_days": {
      "type": "number",
      "default": 30,
      "description": "Ile dni od dodania produktu pokazywa\u0107 znaczek \u201eNowo\u015b\u0107\u201d (0 = nigdy)"
    },
    "product_note": {
      "type": "string",
      "description": "Informacja og\u00f3lna wy\u015bwietlana przy ka\u017cdym produkcie w sklepie (ta sama dla wszystkich)"
    },
    "contact_email": {
      "type": "string",
      "description": "Adres kontaktowy sklepu"
    },
    "is_open": {
      "type": "boolean",
      "default": true,
      "description": "Czy sklep przyjmuje zam\u00f3wienia"
    },
    "product_commission_type": {
      "type": "string",
      "enum": [
        "none",
        "percent",
        "amount"
      ],
      "default": "none",
      "description": "Wsp\u00f3lna prowizja pracownika od sprzeda\u017cy produkt\u00f3w: none = brak, percent = procent od sprzeda\u017cy, amount = sta\u0142a kwota od sztuki"
    },
    "product_commission_value": {
      "type": "number",
      "default": 0,
      "description": "Warto\u015b\u0107 prowizji produktowej: procent (product_commission_type = percent) albo kwota PLN od sztuki (amount)"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "EventSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "default": "default"
    },
    "booking_enabled": {
      "type": "boolean",
      "default": true,
      "description": "True = oferty przyjmuj\u0105 zapisy online (przycisk rezerwacji dzia\u0142a, formularz zapisu jest dost\u0119pny)"
    },
    "home_events_label": {
      "type": "string",
      "description": "Nadtytu\u0142 sekcji ofert na stronie g\u0142\u00f3wnej (puste = OFERTY)"
    },
    "home_events_heading": {
      "type": "string",
      "description": "Nag\u0142\u00f3wek sekcji ofert na stronie g\u0142\u00f3wnej"
    },
    "home_events_text": {
      "type": "string",
      "description": "Opis sekcji ofert na stronie g\u0142\u00f3wnej"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
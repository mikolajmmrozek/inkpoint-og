{
  "name": "ShopOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Numer zam\u00f3wienia (np. ZAM-20261105-4821)"
    },
    "user_email": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "variant_key": {
            "type": "string"
          },
          "variant_label": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "units": {
            "type": "number",
            "default": 1,
            "description": "Liczba sztuk w jednym pakiecie (wielosztuka) \u2014 1 = pojedyncza sztuka. Quantity = liczba pakiet\u00f3w."
          },
          "shipping_option": {
            "type": "string",
            "description": "Wybrana opcja dostawy dla tej pozycji"
          },
          "shipping_cost": {
            "type": "number",
            "description": "Koszt wybranej opcji dostawy dla tej pozycji"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "discount_code": {
      "type": "string"
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "voucher_code": {
      "type": "string"
    },
    "voucher_amount": {
      "type": "number",
      "default": 0
    },
    "shipping_cost": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "shipped",
        "completed",
        "cancelled",
        "returned"
      ],
      "default": "pending"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "refunded"
      ],
      "default": "unpaid"
    },
    "shipping_address": {
      "type": "object",
      "properties": {
        "first_name": {
          "type": "string"
        },
        "last_name": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "billing_address": {
      "type": "object",
      "properties": {
        "first_name": {
          "type": "string"
        },
        "last_name": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "invoice_details": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string"
        },
        "nip": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "customer_note": {
      "type": "string"
    },
    "admin_note": {
      "type": "string"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "by": {
            "type": "string"
          }
        }
      }
    },
    "has_open_return": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "order_number",
    "user_email",
    "items",
    "total"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}